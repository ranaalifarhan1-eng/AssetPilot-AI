ENVIRONMENT=development
LOG_LEVEL=INFO
PORT=8000
HOST=127.0.0.1
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# OKX Read-Only API Credentials (Backend Only - NEVER COMMIT REAL VALUES)
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=

# Traditional Equities Data Provider (Optional - Finnhub Free API Key)
FINNHUB_API_KEY=

# Optional Evidence-Contained AI Reasoning (Backend Only)
AI_REASONING_ENABLED=false
AGENTROUTER_API_KEY=
# Complete configured reasoning endpoint; no default is assumed.
AGENTROUTER_BASE_URL=
AI_PRIMARY_MODEL=gpt-5.6-sol
