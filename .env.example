# AssetPilot AI - Environment Configuration Example

# Backend Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
PORT=8000
HOST=127.0.0.1
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# OKX Read-Only API Credentials (Backend Only - NEVER COMMIT REAL VALUES)
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=

# Traditional Equities Data Provider (Optional - Finnhub Free API Key)
FINNHUB_API_KEY=

# Frontend Environment (Prefix with NEXT_PUBLIC_ for client exposure)
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
