# AssetPilot AI Monorepo Environment Example
# Copy to .env for local development - DO NOT COMMIT .env

# General System Settings
ENVIRONMENT=development
LOG_LEVEL=INFO

# Backend API Configuration
BACKEND_PORT=8000
BACKEND_HOST=127.0.0.1
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Frontend Configuration
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Database Configuration (Future)
DATABASE_URL=postgresql://user:password@localhost:5432/assetpilot_db

# Redis Configuration (Future)
REDIS_URL=redis://localhost:6379/0

# Exchange API Configurations (READ ONLY ONLY)
# Create OKX API Key with READ permission ONLY.
# DO NOT enable Trade or Withdraw permissions.
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=

# AI Provider API Keys (Future)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
